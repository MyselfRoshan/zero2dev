    {
      "id": "django",
      "label": "Django",
      "language": "python",
      "summary": "A Django project in its own virtual environment, with the first migration run.",
      "homepage": "https://www.djangoproject.com",
      "runtime": {
        "kind": "python",
        "min": "3.10"
      },
      "steps": [
        {
          "type": "files",
          "label": "Writing requirements.txt",
          "files": {
            "requirements.txt": "Django\n"
          }
        },
        {
          "type": "run",
          "label": "Installing Django",
          "program": "pip",
          "args": [
            "install",
            "--disable-pip-version-check",
            "--no-input",
            "-r",
            "requirements.txt"
          ],
          "in": "project"
        },
        {
          "type": "run",
          "label": "Creating the Django project",
          "program": "django-admin",
          "args": [
            "startproject",
            "config",
            "."
          ],
          "in": "project"
        },
        {
          "type": "run",
          "label": "Running the first migration",
          "program": "python",
          "args": [
            "manage.py",
            "migrate",
            "--no-input"
          ],
          "in": "project"
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "python",
          "port": 8000,
          "settings": {
            "run": "django",
            "manage": "manage.py"
          }
        }
      ],
      "site": {
        "type": "proxy",
        "https": true
      }
    },
    {
      "id": "fastapi",
      "label": "FastAPI",
      "language": "python",
      "summary": "A FastAPI app served by Uvicorn, in its own virtual environment.",
      "homepage": "https://fastapi.tiangolo.com",
      "runtime": {
        "kind": "python",
        "min": "3.10"
      },
      "steps": [
        {
          "type": "files",
          "label": "Writing main.py and requirements.txt",
          "files": {
            "main.py": "from fastapi import FastAPI\n\napp = FastAPI(title=\"{name}\")\n\n\n@app.get(\"/\")\ndef read_root():\n    return {\"message\": \"{name} works.\"}\n",
            "requirements.txt": "fastapi\nuvicorn[standard]\n"
          }
        },
        {
          "type": "run",
          "label": "Installing FastAPI and Uvicorn",
          "program": "pip",
          "args": [
            "install",
            "--disable-pip-version-check",
            "--no-input",
            "-r",
            "requirements.txt"
          ],
          "in": "project"
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "python",
          "port": 8000,
          "settings": {
            "run": "uvicorn",
            "app": "main:app"
          }
        }
      ],
      "site": {
        "type": "proxy",
        "https": true
      }
    },
