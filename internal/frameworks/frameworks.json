    {
      "id": "wordpress",
      "label": "WordPress",
      "language": "php",
      "summary": "The latest WordPress from wordpress.org, with its database and wp-config.php.",
      "homepage": "https://wordpress.org",
      "runtime": {
        "kind": "php",
        "min": "7.4"
      },
      "database": {
        "kinds": [
          "mariadb",
          "mysql"
        ],
        "default": "mariadb",
        "optional": false
      },
      "steps": [
        {
          "type": "download",
          "label": "Downloading WordPress",
          "url": "https://wordpress.org/latest.zip",
          "checksum": "https://wordpress.org/latest.zip.sha1",
          "strip": 1
        },
        {
          "type": "files",
          "label": "Writing wp-config.php",
          "files": {
            "wp-config.php": "<?php\n// Written by Zero2Dev. The database was made for this site only.\ndefine('DB_NAME', '{db}');\ndefine('DB_USER', '{dbUser}');\ndefine('DB_PASSWORD', '{dbPassword}');\ndefine('DB_HOST', '{dbHost}:{dbPort}');\ndefine('DB_CHARSET', 'utf8mb4');\ndefine('DB_COLLATE', '');\ndefine('AUTH_KEY', '{random}{random}');\ndefine('SECURE_AUTH_KEY', '{random}{random}');\ndefine('LOGGED_IN_KEY', '{random}{random}');\ndefine('NONCE_KEY', '{random}{random}');\ndefine('AUTH_SALT', '{random}{random}');\ndefine('SECURE_AUTH_SALT', '{random}{random}');\ndefine('LOGGED_IN_SALT', '{random}{random}');\ndefine('NONCE_SALT', '{random}{random}');\n$table_prefix = 'wp_';\ndefine('WP_DEBUG', false);\n// The site server terminates HTTPS and tells WordPress so.\nif (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https') {\n\t$_SERVER['HTTPS'] = 'on';\n}\nif (!defined('ABSPATH')) {\n\tdefine('ABSPATH', __DIR__ . '/');\n}\nrequire_once ABSPATH . 'wp-settings.php';\n"
          }
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "php",
          "port": 8000,
          "usesDatabase": true
        }
      ],
      "site": {
        "type": "php",
        "root": "",
        "https": true
      }
    },
    {
      "id": "php",
      "label": "Plain PHP",
      "language": "php",
      "summary": "A starter index.php served by PHP's built-in web server.",
      "runtime": {
        "kind": "php",
        "min": "8.1"
      },
      "steps": [
        {
          "type": "files",
          "label": "Writing index.php",
          "files": {
            "index.php": "<?php\n$name = '{name}';\n?>\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title><?= htmlspecialchars($name) ?></title>\n</head>\n<body>\n  <h1><?= htmlspecialchars($name) ?></h1>\n  <p>PHP <?= PHP_VERSION ?> works.</p>\n</body>\n</html>\n"
          }
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "php",
          "port": 8000
        }
      ],
      "site": {
        "type": "php",
        "root": "",
        "https": true
      }
    },
    {
      "id": "express",
      "label": "Express",
      "language": "javascript",
      "summary": "A small Express 5 server with an npm dev script.",
      "homepage": "https://expressjs.com",
      "runtime": {
        "kind": "node",
        "min": "20"
      },
      "steps": [
        {
          "type": "files",
          "label": "Writing package.json and server.js",
          "files": {
            "package.json": "{\n  \"name\": \"{slug}\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"start\": \"node server.js\",\n    \"dev\": \"node --watch server.js\"\n  },\n  \"dependencies\": {\n    \"express\": \"^5.1.0\"\n  }\n}\n",
            "server.js": "const express = require('express');\n\nconst app = express();\nconst port = process.env.PORT || {port};\n\napp.get('/', (req, res) => {\n  res.send('{name} works.');\n});\n\napp.listen(port, '127.0.0.1', () => {\n  console.log('Listening on http://127.0.0.1:' + port);\n});\n"
          }
        },
        {
          "type": "run",
          "label": "Installing the packages",
          "program": "npm",
          "args": [
            "install",
            "--no-fund",
            "--no-audit"
          ],
          "in": "project",
          "env": {
            "npm_config_yes": "true",
            "CI": "1"
          }
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "node",
          "port": 3000,
          "settings": {
            "run": "npm",
            "npmScript": "dev"
          }
        }
      ],
      "site": {
        "type": "proxy",
        "https": true
      }
    },
