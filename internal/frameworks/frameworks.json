    {
      "id": "go-nethttp",
      "label": "Go (net/http)",
      "language": "go",
      "summary": "A small web server with the standard library only.",
      "runtime": {
        "kind": "go",
        "min": "1.21"
      },
      "steps": [
        {
          "type": "run",
          "label": "Creating the Go module",
          "program": "go",
          "args": [
            "mod",
            "init",
            "{slug}"
          ],
          "in": "project"
        },
        {
          "type": "files",
          "label": "Writing main.go",
          "files": {
            "main.go": "package main\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n\t\"os\"\n)\n\nfunc main() {\n\tport := os.Getenv(\"PORT\")\n\tif port == \"\" {\n\t\tport = \"{port}\"\n\t}\n\thttp.HandleFunc(\"/\", func(w http.ResponseWriter, r *http.Request) {\n\t\tfmt.Fprintln(w, \"{name} works.\")\n\t})\n\thttp.ListenAndServe(\"127.0.0.1:\"+port, nil)\n}\n"
          }
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "go",
          "settings": {
            "package": "."
          },
          "port": 8080
        }
      ],
      "site": {
        "type": "proxy",
        "https": true
      }
    },
    {
      "id": "gin",
      "label": "Gin",
      "language": "go",
      "summary": "A Gin web server (github.com/gin-gonic/gin).",
      "homepage": "https://gin-gonic.com",
      "runtime": {
        "kind": "go",
        "min": "1.24"
      },
      "steps": [
        {
          "type": "run",
          "label": "Creating the Go module",
          "program": "go",
          "args": [
            "mod",
            "init",
            "{slug}"
          ],
          "in": "project"
        },
        {
          "type": "files",
          "label": "Writing main.go",
          "files": {
            "main.go": "package main\n\nimport (\n\t\"net/http\"\n\t\"os\"\n\n\t\"github.com/gin-gonic/gin\"\n)\n\nfunc main() {\n\tport := os.Getenv(\"PORT\")\n\tif port == \"\" {\n\t\tport = \"{port}\"\n\t}\n\tr := gin.Default()\n\tr.GET(\"/\", func(c *gin.Context) {\n\t\tc.String(http.StatusOK, \"{name} works.\")\n\t})\n\tr.Run(\"127.0.0.1:\" + port)\n}\n"
          }
        },
        {
          "type": "run",
          "label": "Downloading the modules",
          "program": "go",
          "args": [
            "mod",
            "tidy"
          ],
          "in": "project"
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "go",
          "settings": {
            "package": "."
          },
          "port": 8080
        }
      ],
      "site": {
        "type": "proxy",
        "https": true
      }
    },
    {
      "id": "fiber",
      "label": "Fiber",
      "language": "go",
      "summary": "A Fiber v3 web server (github.com/gofiber/fiber).",
      "homepage": "https://gofiber.io",
      "runtime": {
        "kind": "go",
        "min": "1.26"
      },
      "steps": [
        {
          "type": "run",
          "label": "Creating the Go module",
          "program": "go",
          "args": [
            "mod",
            "init",
            "{slug}"
          ],
          "in": "project"
        },
        {
          "type": "files",
          "label": "Writing main.go",
          "files": {
            "main.go": "package main\n\nimport (\n\t\"log\"\n\t\"os\"\n\n\t\"github.com/gofiber/fiber/v3\"\n)\n\nfunc main() {\n\tport := os.Getenv(\"PORT\")\n\tif port == \"\" {\n\t\tport = \"{port}\"\n\t}\n\tapp := fiber.New()\n\tapp.Get(\"/\", func(c fiber.Ctx) error {\n\t\treturn c.SendString(\"{name} works.\")\n\t})\n\tlog.Fatal(app.Listen(\"127.0.0.1:\" + port))\n}\n"
          }
        },
        {
          "type": "run",
          "label": "Downloading the modules",
          "program": "go",
          "args": [
            "mod",
            "tidy"
          ],
          "in": "project"
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "go",
          "settings": {
            "package": "."
          },
          "port": 3000
        }
      ],
      "site": {
        "type": "proxy",
        "https": true
      }
    },
    {
      "id": "springboot",
      "label": "Spring Boot",
      "language": "java",
      "summary": "A Maven project from start.spring.io with Spring Web, built with its Maven wrapper.",
      "homepage": "https://spring.io/projects/spring-boot",
      "runtime": {
        "kind": "java",
        "min": "17"
      },
      "steps": [
        {
          "type": "download",
          "label": "Downloading the project from start.spring.io",
          "url": "https://start.spring.io/starter.zip?type=maven-project&language=java&groupId=com.example&artifactId={slug}&name={slug}&dependencies=web&javaVersion=17",
          "unverified": true,
          "reason": "start.spring.io builds the project when you ask for it and publishes no checksum, so the download is protected by HTTPS only",
          "strip": 0
        },
        {
          "type": "run",
          "label": "Building the project",
          "program": "./mvnw.cmd",
          "args": [
            "-q",
            "-DskipTests",
            "package"
          ],
          "in": "project",
          "env": {
            "MAVEN_USER_HOME": "{home}/java/maven"
          }
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "java",
          "port": 8080,
          "settings": {
            "run": "jar",
            "jar": "target/{slug}-0.0.1-SNAPSHOT.jar",
            "springPort": "true"
          }
        }
      ],
      "site": {
        "type": "proxy",
        "https": true
      }
    },
    {
      "id": "axum",
      "label": "Axum",
      "language": "rust",
      "summary": "A small Axum web server (Tokio), built and run with Cargo.",
      "homepage": "https://github.com/tokio-rs/axum",
      "runtime": {
        "kind": "rust",
        "min": "1.75"
      },
      "steps": [
        {
          "type": "files",
          "label": "Writing src/main.rs",
          "files": {
            "src/main.rs": "use axum::{routing::get, Router};\n\n#[tokio::main]\nasync fn main() {\n    let port = std::env::var(\"PORT\").unwrap_or_else(|_| \"3000\".to_string());\n    let app = Router::new().route(\"/\", get(|| async { \"{name} works.\" }));\n    let listener = tokio::net::TcpListener::bind(format!(\"127.0.0.1:{}\", port))\n        .await\n        .unwrap();\n    println!(\"listening on http://127.0.0.1:{}\", port);\n    axum::serve(listener, app).await.unwrap();\n}\n"
          }
        },
        {
          "type": "run",
          "label": "Creating the Cargo package",
          "program": "cargo",
          "args": [
            "init",
            "--vcs",
            "none",
            "--name",
            "{slug}"
          ],
          "in": "project"
        },
        {
          "type": "run",
          "label": "Adding Axum",
          "program": "cargo",
          "args": [
            "add",
            "axum@0.8"
          ],
          "in": "project",
          "timeout": 900
        },
        {
          "type": "run",
          "label": "Adding Tokio",
          "program": "cargo",
          "args": [
            "add",
            "tokio@1",
            "--features",
            "macros,rt-multi-thread,net"
          ],
          "in": "project",
          "timeout": 900
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "rust",
          "port": 3000
        }
      ],
      "site": {
        "type": "proxy",
        "https": true
      }
    },
    {
      "id": "html",
      "label": "HTML and CSS",
      "language": "static",
      "summary": "A starter page served by the site server.",
      "runtime": {
        "kind": ""
      },
      "steps": [
        {
          "type": "files",
          "label": "Writing the starter page",
          "files": {
            "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>{name}</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <h1>{name}</h1>\n  <p>It works.</p>\n</body>\n</html>\n",
            "style.css": "body { font-family: system-ui, sans-serif; margin: 2rem; }\n"
          }
        }
      ],
      "services": [],
      "site": {
        "type": "static",
        "root": ".",
        "https": true
      }
    }
  ]
}
