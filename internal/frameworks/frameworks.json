{
  "format": 1,
  "frameworks": [
    {
      "id": "laravel",
      "label": "Laravel",
      "language": "php",
      "summary": "The PHP framework for web artisans, made with composer create-project.",
      "homepage": "https://laravel.com",
      "runtime": {
        "kind": "php",
        "min": "8.2"
      },
      "composer": true,
      "database": {
        "kinds": [
          "mariadb",
          "mysql"
        ],
        "default": "mariadb",
        "optional": true
      },
      "steps": [
        {
          "type": "run",
          "label": "Creating the Laravel project",
          "program": "composer",
          "args": [
            "create-project",
            "laravel/laravel",
            "{slug}",
            "--no-interaction",
            "--no-progress"
          ],
          "in": "parent"
        }
      ],
      "services": [
        {
          "name": "{name}",
          "kind": "php",
          "port": 8000,
          "usesDatabase": true,
          "settings": {
            "docroot": "public"
          }
        }
      ],
      "site": {
        "type": "php",
        "root": "public",
        "https": true
      },
      "env": [
        {
          "key": "APP_URL",
          "value": "https://{domain}"
        },
        {
          "key": "DB_CONNECTION",
          "value": "mysql"
        },
        {
          "key": "DB_HOST",
          "value": "{dbHost}"
        },
        {
          "key": "DB_PORT",
          "value": "{dbPort}"
        },
        {
          "key": "DB_DATABASE",
          "value": "{db}"
        },
        {
          "key": "DB_USERNAME",
          "value": "{dbUser}"
        },
        {
          "key": "DB_PASSWORD",
          "value": "{dbPassword}"
        },
        {
          "key": "SESSION_DRIVER",
          "value": "file"
        },
        {
          "key": "CACHE_STORE",
          "value": "file"
        },
        {
          "key": "QUEUE_CONNECTION",
          "value": "sync"
        }
      ],
      "envFile": ".env"
    },
    {
      "id": "symfony",
      "label": "Symfony",
      "language": "php",
      "summary": "The Symfony skeleton, made with composer create-project.",
      "homepage": "https://symfony.com",
      "runtime": {
        "kind": "php",
        "min": "8.2"
      },
      "composer": true,
      "database": {
        "kinds": [
